{
  "name": "@tinqerjs/better-sqlite3-adapter-integration",
  "version": "0.0.27",
  "private": true,
  "type": "module",
  "description": "SQLite integration tests for Tinqer using better-sqlite3",
  "scripts": {
    "test": "npm run test:build && mocha",
    "test:watch": "npm test -- --watch",
    "test:grep": "npm test -- --grep",
    "test:build": "bash ../../scripts/build-tests.sh",
    "lint": "eslint tests --ext .ts",
    "lint:fix": "eslint tests --ext .ts --fix"
  },
  "dependencies": {
    "@tinqerjs/tinqer": "file:../tinqer",
    "@tinqerjs/better-sqlite3-adapter": "file:../better-sqlite3-adapter",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "chai": "^6.2.2",
    "mocha": "^12.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
