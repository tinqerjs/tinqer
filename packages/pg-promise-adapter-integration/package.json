{
  "name": "@tinqerjs/pg-promise-adapter-integration",
  "version": "0.0.26",
  "description": "PostgreSQL integration tests for Tinqer using pg-promise",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "mocha tests/**/*.test.ts",
    "test:watch": "mocha tests/**/*.test.ts --watch",
    "test:grep": "mocha tests/**/*.test.ts --grep",
    "test:build": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint tests --ext .ts",
    "lint:fix": "eslint tests --ext .ts --fix"
  },
  "dependencies": {
    "@tinqerjs/tinqer": "file:../tinqer",
    "@tinqerjs/pg-promise-adapter": "file:../pg-promise-adapter",
    "pg-promise": "^12.6.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
