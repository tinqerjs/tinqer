{
  "name": "@tinqerjs/pg-promise-adapter-integration",
  "version": "0.0.28",
  "description": "PostgreSQL integration tests for Tinqer using pg-promise",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "npm run test:build && mocha",
    "test:watch": "npm test -- --watch",
    "test:grep": "npm test -- --grep",
    "test:build": "bash ../../scripts/build-tests.sh",
    "lint": "eslint tests --ext .ts",
    "lint:fix": "eslint tests --ext .ts --fix"
  },
  "dependencies": {
    "@tinqerjs/tinqer": "file:../tinqer",
    "@tinqerjs/pg-promise-adapter": "file:../pg-promise-adapter",
    "pg-promise": "^12.7.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "chai": "^6.2.2",
    "mocha": "^12.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
