{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./"
  },
  "include": ["tests/**/*"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "compilerOptions": {
