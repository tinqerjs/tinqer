{
  "name": "@tinqerjs/tinqer",
  "version": "0.0.28",
  "description": "LINQ to SQL for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run test:build && mocha --exit",
    "test:grep": "npm test -- --grep",
    "test:build": "bash ../../scripts/build-tests.sh",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix"
  },
  "dependencies": {
    "oxc-parser": "0.150.0"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/estree": "^1.0.9",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.2",
    "chai": "6.2.2",
    "mocha": "12.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "keywords": [
    "linq",
    "sql",
    "query",
    "builder",
    "typescript",
    "orm",
    "database",
    "postgres",
    "mysql",
    "sqlite"
  ],
  "author": "WebPods",
  "license": "MIT"
}
